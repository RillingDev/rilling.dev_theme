<div class="index">
    <h1 class="visually-hidden">Articles</h1>
    <% page.posts.each((post)=>{ %>
        <%- partial('_partial/article', { post: post, index: true }) %>
    <% }); %>

    <% if(page.total > 1){ %>
        <nav aria-label="Page navigation" class="pagination">
            <%- paginator({
                prev_text: '« Newer Articles',
                next_text: 'Previous Articles »'
            }) %>
        </nav>
    <% } %>
</div>

