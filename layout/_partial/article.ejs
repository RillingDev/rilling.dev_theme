<article class="article <%= index ? '' : 'article--full' %>">

    <header>
        <% if (index){ %>
            <h2 class="article__title">
                <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h2>
        <% } else { %>
            <h1 class="article__title"><%= post.title %></h1>
        <% } %>
        <div class="article__meta">
            <p>Published: <time datetime="<%= date_xml(post.date) %>"><%= date(post.date) %></time></p>
            <p>Last updated: <time datetime="<%= date_xml(post.updated) %>"><%= date(post.updated) %></time></p>
        </div>
    </header>

    <div class="article__content">
        <% if (post.excerpt && index){ %>
            <%- post.excerpt %>
            <a href="<%- url_for(post.path) %>">Read '<%= post.title %>'</a>
        <% } else { %>
            <%- post.content %>
        <% } %>
    </div>

</article>
