<div class="container">
    <nav class="navbar">
        <a class="navbar__title" href="<%- url_for('/'); %>">
            <img class="navbar__logo" src="<%- url_for('icon.svg'); %>" width="22" height="22" alt="">
            <span><%= config.title %></span>
        </a>
        <ul class="navbar__nav">
            <% for (const [name, path] of Object.entries(theme.menu)){ %>
            <%_
                let isCurrent = false;
                if (is_current(path)) {
                    isCurrent = true;
                } else if (is_post() && name === 'Blog') {
                    isCurrent = true;
                }
            _%>
            <li>
                <% if (isCurrent){ %>
                    <a class="navbar__nav__link active" href="<%- url_for(path); %>" aria-current="page">
                        <%= name; %>
                    </a>
                <% } else { %>
                    <a class="navbar__nav__link" href="<%- url_for(path); %>">
                        <%= name; %>
                    </a>
                <% } %>
            </li>
            <% } %>
        </ul>
    </nav>
</div>
