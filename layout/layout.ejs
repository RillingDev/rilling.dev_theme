<!DOCTYPE html>
<html lang="<%= config.language %>" dir="ltr" prefix="og: https://ogp.me/ns#">
<head>
    <!-- Priority 1 -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= page.title ?? "Blog" %> | <%= config.title %></title>

    <!-- Priority 2 -->
    <!-- Construct the entire tag instead of using the hexo helpers as they break with query parameters -->
    <link rel="stylesheet" href="<%- url_for('app.css?v=4') %>">
    <meta name="theme-color" content="#222222">

    <!-- Priority 3 -->
    <meta name="author" content="<%= config.author %>">
    <%- open_graph({
        image: url_for('apple-touch-icon.png')
    }); %>

    <!--
    Icons generated through https://realfavicongenerator.net/
    Details from https://evilmartians.com/chronicles/how-to-favicon-in-2021-six-files-that-fit-most-needs
    -->
    <link rel="icon" href="<%- url_for('favicon.ico?v=2'); %>" sizes="32x32">
    <link rel="icon" href="<%- url_for('favicon.svg?v=2'); %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%- url_for('apple-touch-icon.png?v=2'); %>">

    <link rel="alternate" href="<%- url_for('rss2.xml'); %>" type="application/rss+xml">
    <link rel="alternate" href="<%- url_for('atom.xml'); %>" type="application/atom+xml">
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<%- partial('_partial/navbar'); %>
<div class="container">
    <main id="main" class="main">
        <%- body; %>
    </main>
</div>
<%- partial('_partial/footer'); %>
</body>
</html>
